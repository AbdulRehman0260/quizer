# Backend configuration.
# Local dev needs NONE of these — the code falls back to localhost defaults.
# Set these in the Railway dashboard for production.

# Full Postgres connection string.
# Local default (if unset): postgres://postgres:postgres@localhost:5432/questions
# Railway: reference the managed database, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/questions

# Origin allowed by CORS — the frontend's public URL.
# Local default (if unset): http://localhost:5173
# Railway: https://<your-frontend>.up.railway.app
CORS_ORIGIN=http://localhost:5173

# PORT is injected automatically by Railway — do not set it there.
# Locally it defaults to 3000 if unset.
